<UserControl x:Class="Fjord.Views.SftpTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Fjord.Views">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Optional two-pane layout (Settings → SFTP): this PC | splitter | server.
             With one pane, the first two columns have zero width. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LocalColumn" Width="0" />
                <ColumnDefinition x:Name="SplitterColumn" Width="0" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <local:LocalPane x:Name="Local" Visibility="Collapsed" />
            <GridSplitter x:Name="PaneSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" Visibility="Collapsed" ResizeBehavior="PreviousAndNext"
                          ToolTip="Drag to resize the panes" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <DockPanel Margin="8,6,8,6">
                    <StackPanel x:Name="NavButtons" DockPanel.Dock="Left" Orientation="Horizontal" />
                    <StackPanel x:Name="ActionButtons" DockPanel.Dock="Right" Orientation="Horizontal" />
                    <TextBox x:Name="PathBox" Margin="6,0,6,0" VerticalContentAlignment="Center"
                             KeyDown="PathBox_KeyDown" ToolTip="Remote path — type a path and press Enter" />
                </DockPanel>

                <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended"
                          CanUserResizeRows="False" AllowDrop="True" Margin="8,0,8,0"
                          MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown" PreviewKeyDown="Grid_PreviewKeyDown"
                          PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                          PreviewMouseMove="Grid_PreviewMouseMove"
                          DragOver="Grid_DragOver" Drop="Grid_Drop">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Name" Width="*" SortMemberPath="SortKey" CanUserSort="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,2">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" Foreground="{Binding IconBrush}" />
                                        <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="100" />
                        <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}" Width="140" />
                        <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}" Width="110" FontFamily="Cascadia Mono, Consolas" />
                        <DataGridTextColumn Header="Owner" Binding="{Binding OwnerName}" SortMemberPath="OwnerName" Width="90" />
                        <DataGridTextColumn Header="Group" Binding="{Binding GroupName}" SortMemberPath="GroupName" Width="90" />
                    </DataGrid.Columns>
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open" InputGestureText="Enter" Click="Open_Click" />
                            <MenuItem Header="Open with…" Click="OpenWith_Click" />
                            <MenuItem Header="Download…" Click="Download_Click" />
                            <Separator />
                            <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="Cut_Click" />
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="Copy_Click" />
                            <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="Paste_Click" />
                            <Separator />
                            <MenuItem Header="Rename or move…" InputGestureText="F2" Click="Rename_Click" />
                            <MenuItem Header="Permissions…" Click="Permissions_Click" />
                            <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click" />
                            <Separator />
                            <MenuItem Header="Copy path" Click="CopyPath_Click" />
                            <MenuItem Header="New file…" Click="NewFile_Click" />
                            <MenuItem Header="New folder…" Click="NewFolder_Click" />
                            <MenuItem Header="Upload files…" Click="Upload_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- Status / progress -->
        <DockPanel Grid.Row="1" Margin="10,6,10,8">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" Margin="8,0,0,0" />
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="200" Height="6" Visibility="Collapsed" VerticalAlignment="Center" />
            <!-- Files open in a Windows editor; saving them uploads automatically. -->
            <Border x:Name="EditingBadge" DockPanel.Dock="Right" Visibility="Collapsed" Margin="8,0,0,0" Padding="8,2"
                    CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="12" />
                    <TextBlock x:Name="EditingText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Text="Tip: drag files in from Explorer to upload, or out to Explorer to download." />
        </DockPanel>
    </Grid>
</UserControl>
