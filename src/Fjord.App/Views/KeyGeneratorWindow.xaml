<Window x:Class="Fjord.Views.KeyGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH key generator" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="22">
        <TextBlock Style="{StaticResource Hint}">
            Creates a key pair in the standard OpenSSH format — the same files <Run FontFamily="Cascadia Mono, Consolas">ssh-keygen</Run>
            makes on Linux. The private key stays on this PC; the .pub file goes on servers.
            <Hyperlink Click="Guide_Click">How do keys work?</Hyperlink>
        </TextBlock>

        <TextBlock Text="KEY TYPE" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
        <RadioButton x:Name="TypeEd25519" GroupName="type" IsChecked="True" Checked="Type_Changed"
                     Content="Ed25519 — recommended (short, fast, modern; OpenSSH 6.5+)" />
        <RadioButton x:Name="TypeRsa" GroupName="type" Margin="0,4,0,0" Checked="Type_Changed"
                     Content="RSA 4096 — only for old servers/devices without Ed25519 support" />

        <TextBlock Text="COMMENT" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
        <TextBox x:Name="CommentBox" />
        <TextBlock Text="Shown at the end of the public key — helps you recognise it in authorized_keys later."
                   Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <TextBlock Text="PASSPHRASE (OPTIONAL)" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="PassBox" ToolTip="Passphrase" />
            <PasswordBox x:Name="PassConfirmBox" Grid.Column="2" ToolTip="Repeat passphrase" />
        </Grid>
        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                   Text="Encrypts the private key file. If someone copies the file, they still can't use it. Fjord asks for it once per session." />

        <TextBlock Text="SAVE AS" Style="{StaticResource SectionHeader}" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" />
            <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
        </Grid>
        <TextBlock x:Name="PathHint" Style="{StaticResource Hint}" Margin="0,4,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="GenerateButton" Content="Generate and save" IsDefault="True" MinWidth="150" Click="Generate_Click" />
            <Button Content="Close" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>

        <!-- Result -->
        <StackPanel x:Name="ResultPanel" Visibility="Collapsed" Margin="0,18,0,0">
            <TextBlock Text="PUBLIC KEY — this is what you put on servers" Style="{StaticResource SectionHeader}" />
            <TextBox x:Name="PublicKeyBox" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" MaxHeight="120"
                     VerticalScrollBarVisibility="Auto" />
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="Copy public key" Click="CopyPublic_Click" />
                <TextBlock x:Name="FingerprintText" Style="{StaticResource Hint}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
            </DockPanel>
            <TextBlock x:Name="SavedText" Style="{StaticResource Hint}" Margin="0,10,0,0" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                Next: connect to the server with your password and click <Bold>Install key</Bold> in the session toolbar,
                then edit the session and switch it to <Bold>Private key</Bold>.
            </TextBlock>
        </StackPanel>
    </StackPanel>
</Window>
