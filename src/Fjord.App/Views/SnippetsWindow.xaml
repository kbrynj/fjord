<Window x:Class="Fjord.Views.SnippetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snippets" Width="820" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- List -->
        <DockPanel>
            <StackPanel x:Name="ListButtons" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" />
            <ListBox x:Name="List" SelectionChanged="List_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Editor -->
        <DockPanel x:Name="Editor" Grid.Column="2">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="Name" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Folder (menu group, optional)" Style="{StaticResource SectionHeader}" />
                <ComboBox x:Name="FolderBox" IsEditable="True" Text="{Binding Folder, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Command — one per line; each line is sent as its own command" Style="{StaticResource SectionHeader}" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
                <CheckBox Content="Press Enter after the last line (run it). Off = type it, so you can edit before running."
                          IsChecked="{Binding Run}" Margin="0,10,0,0" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                    <Run FontWeight="SemiBold">{ask:Label}</Run> asks for a value when the snippet runs, e.g.
                    <Run FontFamily="Cascadia Mono, Consolas">journalctl -u {ask:Service} -f</Run>.
                    The first nine snippets also run with <Run FontWeight="SemiBold">Ctrl+Shift+1…9</Run> in a terminal;
                    <Run FontWeight="SemiBold">Ctrl+Shift+S</Run> opens the menu.
                </TextBlock>
            </StackPanel>
            <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Cascadia Mono, Consolas" TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
        </DockPanel>
        <TextBlock x:Name="EmptyHint" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Center"
                   Text="Add a snippet to get started." Visibility="Collapsed" />

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" IsDefault="False" MinWidth="90" Click="Save_Click" />
            <Button Content="Close" MinWidth="90" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
