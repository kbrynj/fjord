<UserControl x:Class="Fjord.Views.LocalPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: same shape as the server side, so the two panes line up -->
        <DockPanel Margin="8,6,4,6">
            <StackPanel x:Name="NavButtons" DockPanel.Dock="Left" Orientation="Horizontal" />
            <StackPanel x:Name="ActionButtons" DockPanel.Dock="Right" Orientation="Horizontal" />
            <TextBox x:Name="PathBox" Margin="6,0,6,0" VerticalContentAlignment="Center"
                     KeyDown="PathBox_KeyDown" ToolTip="Folder on this PC — type a path and press Enter" />
        </DockPanel>

        <DataGrid x:Name="FileGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Extended"
                  CanUserResizeRows="False" AllowDrop="True" Margin="8,0,4,0"
                  MouseDoubleClick="Grid_MouseDoubleClick" KeyDown="Grid_KeyDown"
                  PreviewMouseLeftButtonDown="Grid_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Grid_PreviewMouseLeftButtonUp"
                  PreviewMouseMove="Grid_PreviewMouseMove" DragOver="Grid_DragOver" Drop="Grid_Drop">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Name (this PC)" Width="*" SortMemberPath="SortKey" CanUserSort="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Glyph}" Foreground="{Binding IconBrush}" />
                                <TextBlock Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" />
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}" Width="130" />
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open" InputGestureText="Enter" Click="Open_Click" />
                    <MenuItem Header="Upload to server" Click="Upload_Click" />
                    <Separator />
                    <MenuItem Header="Rename…" InputGestureText="F2" Click="Rename_Click" />
                    <MenuItem Header="Delete" InputGestureText="Del" Click="Delete_Click" />
                    <Separator />
                    <MenuItem Header="New folder…" Click="NewFolder_Click" />
                    <MenuItem Header="Show in Explorer" Click="ShowInExplorer_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>
    </Grid>
</UserControl>
