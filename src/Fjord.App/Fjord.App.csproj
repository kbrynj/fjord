<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fjord</RootNamespace>
    <AssemblyName>Fjord</AssemblyName>
    <ApplicationIcon>Assets\fjord.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <!-- WPF's Fluent theme (ThemeMode) is flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fjord.Core\Fjord.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Terminal (xterm.js) and guide pages, served to WebView2 from the output folder. -->
    <None Include="Assets\terminal\**;Assets\guide\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\fjord.ico;Assets\fjord.png" />
  </ItemGroup>

</Project>
