<Window x:Class="Fjord.Dialogs.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" MinWidth="380" MaxWidth="560">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBox x:Name="TextField" />
        <PasswordBox x:Name="PasswordInput" Visibility="Collapsed" />
        <CheckBox x:Name="OptionCheck" Margin="0,12,0,0" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" IsDefault="True" MinWidth="90" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
