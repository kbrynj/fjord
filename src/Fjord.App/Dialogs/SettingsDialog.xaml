<Window x:Class="Fjord.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="TERMINAL" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
        <TextBlock Text="Font (CSS font list)" Style="{StaticResource Hint}" />
        <TextBox x:Name="FontBox" Margin="0,4,0,0" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Font size" Style="{StaticResource Hint}" />
                <TextBox x:Name="FontSizeBox" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Scrollback lines" Style="{StaticResource Hint}" />
                <TextBox x:Name="ScrollbackBox" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>
        <CheckBox x:Name="CopyOnSelectBox" Content="Copy on select, right-click pastes (PuTTY style)" Margin="0,12,0,0" />
        <CheckBox x:Name="CursorBlinkBox" Content="Blinking cursor" Margin="0,6,0,0" />

        <TextBlock Text="SFTP" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
        <CheckBox x:Name="TwoPaneBox" Content="Two panes: this PC on the left, the server on the right" />
        <TextBlock Style="{StaticResource Hint}" Margin="26,2,0,0"
                   Text="Drag files between the panes, or use the arrow buttons, to upload and download." />

        <TextBlock Text="GENERAL" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
        <TextBlock Text="Default username for new sessions" Style="{StaticResource Hint}" />
        <TextBox x:Name="DefaultUserBox" Margin="0,4,0,0" />
        <TextBlock Text="Theme (takes effect after restart)" Style="{StaticResource Hint}" Margin="0,10,0,0" />
        <ComboBox x:Name="ThemeBox" Margin="0,4,0,0" Width="160" HorizontalAlignment="Left">
            <ComboBoxItem Content="System" />
            <ComboBoxItem Content="Light" />
            <ComboBoxItem Content="Dark" />
        </ComboBox>

        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0">
            Data folder: <Hyperlink Click="OpenDataFolder_Click"><Run x:Name="DataFolderRun" /></Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Save" IsDefault="True" MinWidth="90" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
