<Window x:Class="Fjord.Dialogs.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="760">
        <StackPanel Margin="20">
            <TextBlock Text="Name" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
            <TextBox x:Name="NameBox" />

            <TextBlock Text="Group / folder" Style="{StaticResource SectionHeader}" />
            <ComboBox x:Name="GroupCombo" IsEditable="True" />

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Host name or IP" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="HostBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Port" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="PortBox" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Username" Style="{StaticResource SectionHeader}" />
            <TextBox x:Name="UserBox" />

            <TextBlock Text="Authentication" Style="{StaticResource SectionHeader}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AuthPassword" Content="Password" GroupName="auth" Checked="Auth_Changed" />
                <RadioButton x:Name="AuthKey" Content="Private key" GroupName="auth" Margin="20,0,0,0" Checked="Auth_Changed" />
            </StackPanel>

            <StackPanel x:Name="KeyPanel" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="KeyPathBox" />
                    <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="BrowseKey_Click" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0">
                    OpenSSH keys (id_ed25519), PEM and PuTTY .ppk all work. No key yet?
                    <Hyperlink Click="GenerateKey_Click">Generate one</Hyperlink>.
                </TextBlock>
            </StackPanel>

            <StackPanel x:Name="SavedPasswordPanel" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="A password is saved for this session." Style="{StaticResource Hint}" VerticalAlignment="Center" />
                <Button Content="Forget it" Margin="10,0,0,0" Click="ForgetPassword_Click" />
            </StackPanel>

            <Expander x:Name="TunnelsExpander" Margin="0,14,0,0">
                <Expander.Header>
                    <TextBlock x:Name="TunnelsHeader" Text="Tunnels (port forwarding)" />
                </Expander.Header>
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Reach things behind this server — a database, an admin page, a PC on their network — from your own PC. Tunnels marked auto-start open when you connect. You can also manage them live from the Tunnels button in a session." />
                    <ListBox x:Name="TunnelList" Margin="0,8,0,0" MinHeight="40" MaxHeight="160" MouseDoubleClick="EditTunnel_Click">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ShortForm}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Opacity="0.75" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Button Content="Add…" MinWidth="80" Click="AddTunnel_Click" />
                        <Button Content="Edit…" MinWidth="80" Margin="6,0,0,0" Click="EditTunnel_Click" />
                        <Button Content="Remove" MinWidth="80" Margin="6,0,0,0" Click="RemoveTunnel_Click" />
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Expander Header="Advanced" Margin="0,14,0,0">
                <StackPanel Margin="0,4,0,0">
                    <TextBlock Text="Keepalive interval (seconds, 0 = off)" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="KeepAliveBox" Width="100" HorizontalAlignment="Left" />
                    <TextBlock Text="Run after login (optional)" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="StartupBox" />
                    <TextBlock Text="SFTP start folder (optional, default = home)" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="SftpPathBox" />
                    <TextBlock Text="Notes" Style="{StaticResource SectionHeader}" />
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Save" IsDefault="True" MinWidth="90" Click="Save_Click" />
                <Button Content="Cancel" IsCancel="True" MinWidth="90" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
