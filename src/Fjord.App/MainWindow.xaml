<Window x:Class="Fjord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fjord" Width="1280" Height="800" MinWidth="760" MinHeight="480"
        Icon="Assets/fjord.ico" WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static ApplicationCommands.New}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.New}" Executed="NewSession_Click" />
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" MinWidth="200" MaxWidth="480" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═════════ Sidebar ═════════ -->
        <Grid Margin="12,10,6,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;"
                        ToolTip="New session (Ctrl+N)" Click="NewSession_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/fjord.png" Width="22" Height="22" />
                    <TextBlock Text="Fjord" FontSize="20" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search sessions" IsHitTestVisible="False"
                           Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" />
            </Grid>

            <ListBox x:Name="ProfileList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="ProfileList_MouseDoubleClick" KeyDown="ProfileList_KeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeader}" Margin="6,10,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3" ToolTip="{Binding Notes}">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Target}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Connect" Click="Connect_Click" FontWeight="SemiBold" />
                        <MenuItem Header="Open SFTP" Click="OpenSftp_Click" />
                        <Separator />
                        <MenuItem Header="Edit…" Click="Edit_Click" />
                        <MenuItem Header="Duplicate" Click="Duplicate_Click" />
                        <MenuItem Header="Delete" Click="Delete_Click" />
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <StackPanel x:Name="ToolsPanel" Grid.Row="3" Margin="0,8,0,0" />
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent" />

        <!-- ═════════ Main area ═════════ -->
        <Grid Grid.Column="2" Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Connect" Margin="8,0,0,0" MinWidth="90" Click="QuickConnect_Click" />
                <Grid>
                    <TextBox x:Name="QuickBox" KeyDown="QuickBox_KeyDown" TextChanged="QuickBox_TextChanged" />
                    <TextBlock x:Name="QuickPlaceholder" Text="Quick connect:  user@host  or  user@host:2222"
                               IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                </Grid>
            </DockPanel>

            <!-- The TabControl only draws the tab strip. Tab contents live in ContentHost and are shown/hidden,
                 never removed — a WebView2 terminal would otherwise be torn down on every tab switch. -->
            <TabControl x:Name="Tabs" Grid.Row="1" SelectionChanged="Tabs_SelectionChanged" Padding="0" BorderThickness="0" />
            <Grid x:Name="ContentHost" Grid.Row="2" />

            <!-- Shown when no tabs are open -->
            <Border x:Name="WelcomePanel" Grid.Row="1" Grid.RowSpan="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock Text="&#xE756;" Style="{StaticResource Glyph}" FontSize="44" HorizontalAlignment="Center" Opacity="0.6" />
                    <TextBlock Text="No open sessions" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center"
                               Text="Double-click a saved session, type user@host above, or create a new one." />
                    <WrapPanel HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Content="New session" Click="NewSession_Click" Margin="4" MinWidth="120" />
                        <Button x:Name="WelcomeImport" Content="Import from PuTTY" Click="WelcomeImport_Click" Margin="4" MinWidth="120" />
                        <Button Content="Generate a key" Click="WelcomeKeygen_Click" Margin="4" MinWidth="120" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,22,0,0"
                               Text="In the terminal: select = copy · right-click = paste · Ctrl+Shift+T = new tab to same server · Ctrl +/− = font size" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
