<Project Sdk="Microsoft.NET.Sdk">

  <!-- UI-free logic: profiles, key generation, SSH connection handling. Unit-testable. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fjord.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <!-- Also pulled in by SSH.NET; referenced directly because the key generator uses its Ed25519. -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

</Project>
